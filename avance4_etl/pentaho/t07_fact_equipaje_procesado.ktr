<transformation><info><name>t07_fact_equipaje_procesado</name><description>Hecho principal: una fila por maleta. Staging (PostgreSQL) + telemetría e inspecciones (MongoDB)</description><extended_description/><trans_version/><trans_type>Normal</trans_type><directory>/</directory><parameters></parameters></info><notepads></notepads><connection><name>pg16_staging_input</name><server>localhost</server><type>POSTGRESQL</type><access>Native</access><database>g8_staging</database><port>5438</port><username>postgres</username><password>0000</password><servername/><data_tablespace/><index_tablespace/><attributes><attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute><attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute><attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute><attribute><code>PORT_NUMBER</code><attribute>5438</attribute></attribute><attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute><attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute><attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>USE_POOLING</code><attribute>N</attribute></attribute></attributes></connection><connection><name>pg16_datamart_output</name><server>localhost</server><type>POSTGRESQL</type><access>Native</access><database>g8_datamart</database><port>5438</port><username>postgres</username><password>0000</password><servername/><data_tablespace/><index_tablespace/><attributes><attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute><attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute><attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute><attribute><code>PORT_NUMBER</code><attribute>5438</attribute></attribute><attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute><attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute><attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>USE_POOLING</code><attribute>N</attribute></attribute></attributes></connection><order><hop><from>Input maletas (mega join del staging)</from><to>¿La entrega ya ocurrió?</to><enabled>Y</enabled></hop><hop><from>¿La entrega ya ocurrió?</from><to>¿Origen distinto de destino?</to><enabled>Y</enabled></hop><hop><from>¿La entrega ya ocurrió?</from><to>Descartadas: entrega futura</to><enabled>Y</enabled></hop><hop><from>¿Origen distinto de destino?</from><to>Regla es_conexion</to><enabled>Y</enabled></hop><hop><from>¿Origen distinto de destino?</from><to>Descartadas: origen igual a destino</to><enabled>Y</enabled></hop><hop><from>Regla es_conexion</from><to>Categoría por peso</to><enabled>Y</enabled></hop><hop><from>Categoría por peso</from><to>Prioridad por clase</to><enabled>Y</enabled></hop><hop><from>Prioridad por clase</from><to>Ordenar maletas por etiqueta</to><enabled>Y</enabled></hop><hop><from>Input telemetría por maleta (MongoDB)</from><to>Texto a fecha (telemetría)</to><enabled>Y</enabled></hop><hop><from>Texto a fecha (telemetría)</from><to>Ordenar telemetría por etiqueta</to><enabled>Y</enabled></hop><hop><from>Input inspecciones por maleta (MongoDB)</from><to>Ordenar inspecciones por etiqueta</to><enabled>Y</enabled></hop><hop><from>Ordenar maletas por etiqueta</from><to>Unir maletas con telemetría</to><enabled>Y</enabled></hop><hop><from>Ordenar telemetría por etiqueta</from><to>Unir maletas con telemetría</to><enabled>Y</enabled></hop><hop><from>Unir maletas con telemetría</from><to>Unir con inspecciones</to><enabled>Y</enabled></hop><hop><from>Ordenar inspecciones por etiqueta</from><to>Unir con inspecciones</to><enabled>Y</enabled></hop><hop><from>Unir con inspecciones</from><to>Tiempos de tránsito y entrega</to><enabled>Y</enabled></hop><hop><from>Tiempos de tránsito y entrega</from><to>¿Entregada a tiempo? (20 min)</to><enabled>Y</enabled></hop><hop><from>¿Entregada a tiempo? (20 min)</from><to>Lookup dim_tiempo</to><enabled>Y</enabled></hop><hop><from>Lookup dim_tiempo</from><to>Lookup aeropuerto origen</to><enabled>Y</enabled></hop><hop><from>Lookup aeropuerto origen</from><to>Lookup aeropuerto conexión</to><enabled>Y</enabled></hop><hop><from>Lookup aeropuerto conexión</from><to>Lookup aeropuerto destino</to><enabled>Y</enabled></hop><hop><from>Lookup aeropuerto destino</from><to>Lookup región origen</to><enabled>Y</enabled></hop><hop><from>Lookup región origen</from><to>Lookup región destino</to><enabled>Y</enabled></hop><hop><from>Lookup región destino</from><to>Lookup dim_vuelo</to><enabled>Y</enabled></hop><hop><from>Lookup dim_vuelo</from><to>Lookup estado de inspección</to><enabled>Y</enabled></hop><hop><from>Lookup estado de inspección</from><to>Lookup tipo de equipaje</to><enabled>Y</enabled></hop><hop><from>Lookup tipo de equipaje</from><to>Añadir secuencia (sk_fact_procesado)</to><enabled>Y</enabled></hop><hop><from>Añadir secuencia (sk_fact_procesado)</from><to>Tipos finales</to><enabled>Y</enabled></hop><hop><from>Tipos finales</from><to>Output fact_equipaje_procesado</to><enabled>Y</enabled></hop></order><step><name>Input maletas (mega join del staging)</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>pg16_staging_input</connection><sql>-- Mega join del staging: una fila por maleta con todas las claves naturales que necesita el hecho
SELECT m.codigo_etiqueta                            AS tag_rfid_bag,
       e.id_pasajero,                                         -- dueño de la maleta
       m.peso_kg,                                             -- peso del check-in (regla de limpieza)
       m.timestamp_evento                           AS ts_checkin,
       en.timestamp_evento                          AS ts_entregado,
       CAST(m.timestamp_evento AS DATE)             AS fecha_checkin,
       SUBSTRING(r.itinerario_vuelos FROM 1 FOR 3)  AS ori,
       SUBSTRING(r.itinerario_vuelos FROM 5 FOR 3)  AS con,
       SUBSTRING(r.itinerario_vuelos FROM 13 FOR 3) AS des,
       ao.region                                    AS region_ori,
       ad.region                                    AS region_des,
       vo.numero_vuelo,
       b.clase_servicio
FROM movimiento_equipaje m
JOIN movimiento_equipaje en ON en.codigo_etiqueta = m.codigo_etiqueta AND en.tipo_evento = 'entregado'
JOIN equipaje e      ON e.id = m.codigo_etiqueta
JOIN boleto b        ON b.id_boleto = m.id_boleto
JOIN reserva_pnr r   ON r.id_reserva_pnr = m.id_codigo_pnr
JOIN aeropuerto ao   ON ao.codigo_aeropuerto = SUBSTRING(r.itinerario_vuelos FROM 1 FOR 3)
JOIN aeropuerto ad   ON ad.codigo_aeropuerto = SUBSTRING(r.itinerario_vuelos FROM 13 FOR 3)
LEFT JOIN segmento_boleto s    ON s.boleto_id = m.id_boleto
LEFT JOIN pase_abordaje pa     ON pa.id_pase_abordaje = s.id_pase_abordaje
LEFT JOIN asignacion_puerta ap ON ap.id_asignacion = pa.id_asignacion_puerta
LEFT JOIN vuelo_operado vo     ON vo.id_vuelo_operado = ap.vuelo_asociado
WHERE m.tipo_evento = 'check_in'
ORDER BY m.codigo_etiqueta</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>68</xloc><yloc>84</yloc><draw>Y</draw></GUI></step><step><name>¿La entrega ya ocurrió?</name><type>FilterRows</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><send_true_to>¿Origen distinto de destino?</send_true_to><send_false_to>Descartadas: entrega futura</send_false_to><compare><condition><negated>N</negated><leftvalue>ts_entregado</leftvalue><function>&lt;=</function><rightvalue/><value><name>constant</name><type>Date</type><text>2026/11/16 23:59:59.000</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask>yyyy/MM/dd HH:mm:ss.SSS</mask></value></condition></compare><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>340</xloc><yloc>84</yloc><draw>Y</draw></GUI></step><step><name>Descartadas: entrega futura</name><type>TextFileOutput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><separator>;</separator><enclosure>&quot;</enclosure><enclosure_forced>N</enclosure_forced><enclosure_fix_disabled>N</enclosure_fix_disabled><header>Y</header><footer>N</footer><format>DOS</format><compression>None</compression><encoding>UTF-8</encoding><endedLine/><fileNameInField>N</fileNameInField><fileNameField/><create_parent_folder>Y</create_parent_folder><file><name>${Internal.Entry.Current.Directory}/descartes/maletas_entrega_futura</name><is_command>N</is_command><servlet_output>N</servlet_output><do_not_open_new_file_init>N</do_not_open_new_file_init><extention>csv</extention><append>N</append><split>N</split><haspartno>N</haspartno><add_date>N</add_date><add_time>N</add_time><SpecifyFormat>N</SpecifyFormat><date_time_format/><add_to_result_filenames>N</add_to_result_filenames><pad>N</pad><fast_dump>N</fast_dump><splitevery>0</splitevery></file><fields><field><name>tag_rfid_bag</name><type>String</type><format></format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>ori</name><type>String</type><format></format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>con</name><type>String</type><format></format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>des</name><type>String</type><format></format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>ts_checkin</name><type>Date</type><format>yyyy-MM-dd HH:mm:ss</format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>ts_entregado</name><type>Date</type><format>yyyy-MM-dd HH:mm:ss</format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field></fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>340</xloc><yloc>280</yloc><draw>Y</draw></GUI></step><step><name>¿Origen distinto de destino?</name><type>FilterRows</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><send_true_to>Regla es_conexion</send_true_to><send_false_to>Descartadas: origen igual a destino</send_false_to><compare><condition><negated>N</negated><leftvalue>ori</leftvalue><function>&lt;&gt;</function><rightvalue>des</rightvalue></condition></compare><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>612</xloc><yloc>84</yloc><draw>Y</draw></GUI></step><step><name>Descartadas: origen igual a destino</name><type>TextFileOutput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><separator>;</separator><enclosure>&quot;</enclosure><enclosure_forced>N</enclosure_forced><enclosure_fix_disabled>N</enclosure_fix_disabled><header>Y</header><footer>N</footer><format>DOS</format><compression>None</compression><encoding>UTF-8</encoding><endedLine/><fileNameInField>N</fileNameInField><fileNameField/><create_parent_folder>Y</create_parent_folder><file><name>${Internal.Entry.Current.Directory}/descartes/maletas_origen_igual_destino</name><is_command>N</is_command><servlet_output>N</servlet_output><do_not_open_new_file_init>N</do_not_open_new_file_init><extention>csv</extention><append>N</append><split>N</split><haspartno>N</haspartno><add_date>N</add_date><add_time>N</add_time><SpecifyFormat>N</SpecifyFormat><date_time_format/><add_to_result_filenames>N</add_to_result_filenames><pad>N</pad><fast_dump>N</fast_dump><splitevery>0</splitevery></file><fields><field><name>tag_rfid_bag</name><type>String</type><format></format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>ori</name><type>String</type><format></format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>con</name><type>String</type><format></format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>des</name><type>String</type><format></format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>ts_checkin</name><type>Date</type><format>yyyy-MM-dd HH:mm:ss</format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>ts_entregado</name><type>Date</type><format>yyyy-MM-dd HH:mm:ss</format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field></fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>612</xloc><yloc>280</yloc><draw>Y</draw></GUI></step><step><name>Regla es_conexion</name><type>Formula</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><formula><field_name>es_conexion</field_name><formula_string>IF(OR([ori]=[con];[con]=[des]);0;1)</formula_string><value_type>Integer</value_type><value_length>-1</value_length><value_precision>-1</value_precision><replace_field/></formula><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>884</xloc><yloc>84</yloc><draw>Y</draw></GUI></step><step><name>Categoría por peso</name><type>NumberRange</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><inputField>peso_kg</inputField><outputField>categoria</outputField><fallBackValue></fallBackValue><rules><rule><lower_bound>-1000000000.0</lower_bound><upper_bound>10.0</upper_bound><value>Ligera (menos de 10 kg)</value></rule><rule><lower_bound>10.0</lower_bound><upper_bound>23.001</upper_bound><value>Estándar (10 a 23 kg)</value></rule><rule><lower_bound>23.001</lower_bound><upper_bound>1000000000.0</upper_bound><value>Sobrepeso (más de 23 kg)</value></rule></rules><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>1156</xloc><yloc>84</yloc><draw>Y</draw></GUI></step><step><name>Prioridad por clase</name><type>ValueMapper</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><field_to_use>clase_servicio</field_to_use><target_field>prioridad_entrega</target_field><non_match_default/><fields><field><source_value>F</source_value><target_value>Prioritaria</target_value></field><field><source_value>J</source_value><target_value>Prioritaria</target_value></field><field><source_value>W</source_value><target_value>Normal</target_value></field><field><source_value>Y</source_value><target_value>Normal</target_value></field></fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>1428</xloc><yloc>84</yloc><draw>Y</draw></GUI></step><step><name>Ordenar maletas por etiqueta</name><type>SortRows</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><directory>%%java.io.tmpdir%%</directory><prefix>out</prefix><sort_size>1000000</sort_size><free_memory/><compress>N</compress><compress_variable/><unique_rows>N</unique_rows><fields><field><name>tag_rfid_bag</name><ascending>Y</ascending><case_sensitive>Y</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field></fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>1700</xloc><yloc>84</yloc><draw>Y</draw></GUI></step><step><name>Input telemetría por maleta (MongoDB)</name><type>MongoDbInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><hostname/><port/><use_all_replica_members>N</use_all_replica_members><db_name>aeropuerto_nosql</db_name><fields_name/><collection>telemetria_escanner_equipaje</collection><json_field_name>json</json_field_name><json_query>{&quot;$group&quot;: {&quot;_id&quot;: &quot;$codigo_etiqueta&quot;, &quot;t_fact&quot;: {&quot;$max&quot;: {&quot;$cond&quot;: [{&quot;$eq&quot;: [&quot;$punto_control&quot;, &quot;FACTURACION&quot;]}, &quot;$timestamp&quot;, null]}}, &quot;t_carr&quot;: {&quot;$max&quot;: {&quot;$cond&quot;: [{&quot;$eq&quot;: [&quot;$punto_control&quot;, &quot;CARRUSEL&quot;]}, &quot;$timestamp&quot;, null]}}, &quot;desvio&quot;: {&quot;$max&quot;: {&quot;$cond&quot;: [{&quot;$in&quot;: [&quot;DESVIACION_LIGERA&quot;, {&quot;$ifNull&quot;: [&quot;$alertas_detectadas&quot;, []]}]}, 1, 0]}}}}, {&quot;$project&quot;: {&quot;_id&quot;: 0, &quot;tag_mongo&quot;: &quot;$_id&quot;, &quot;ts_facturacion&quot;: {&quot;$dateToString&quot;: {&quot;format&quot;: &quot;%Y-%m-%d %H:%M:%S&quot;, &quot;date&quot;: &quot;$t_fact&quot;}}, &quot;ts_carrusel&quot;: {&quot;$dateToString&quot;: {&quot;format&quot;: &quot;%Y-%m-%d %H:%M:%S&quot;, &quot;date&quot;: &quot;$t_carr&quot;}}, &quot;transferencia_exitosa&quot;: {&quot;$subtract&quot;: [1, &quot;$desvio&quot;]}}}, {&quot;$sort&quot;: {&quot;tag_mongo&quot;: 1}}</json_query><auth_database/><auth_user/><auth_password/><auth_mech/><auth_kerberos>N</auth_kerberos><connect_timeout/><socket_timeout/><use_ssl_socket_factory>N</use_ssl_socket_factory><read_preference>primary</read_preference><output_json>N</output_json><query_is_pipeline>Y</query_is_pipeline><execute_for_each_row>N</execute_for_each_row><use_connection_string>Y</use_connection_string><use_legacy_options>N</use_legacy_options><connection_string>${G8_MONGO_URI}</connection_string><mongo_fields><mongo_field><field_name>tag_mongo</field_name><field_path>$.tag_mongo</field_path><field_type>String</field_type><indexed_vals/></mongo_field><mongo_field><field_name>ts_facturacion</field_name><field_path>$.ts_facturacion</field_path><field_type>String</field_type><indexed_vals/></mongo_field><mongo_field><field_name>ts_carrusel</field_name><field_path>$.ts_carrusel</field_path><field_type>String</field_type><indexed_vals/></mongo_field><mongo_