<?xml version="1.0" encoding="UTF-8"?>
<job><name>j00_cargar_datamart</name><description>Carga completa del Data Mart G8: prepara las tablas, carga las 6 dimensiones y luego los 2 hechos</description><extended_description/><job_version/><job_status>0</job_status><directory>/</directory><parameters></parameters><connection><name>pg16_datamart_output</name><server>localhost</server><type>POSTGRESQL</type><access>Native</access><database>g8_datamart</database><port>5438</port><username>postgres</username><password>0000</password><servername/><data_tablespace/><index_tablespace/><attributes><attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute><attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute><attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute><attribute><code>PORT_NUMBER</code><attribute>5438</attribute></attribute><attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute><attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute><attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>USE_POOLING</code><attribute>N</attribute></attribute></attributes></connection><slaveservers></slaveservers><entries><entry><name>START</name><description/><type>SPECIAL</type><start>Y</start><dummy>N</dummy><repeat>N</repeat><schedulerType>0</schedulerType><intervalSeconds>0</intervalSeconds><intervalMinutes>60</intervalMinutes><hour>12</hour><minutes>0</minutes><weekDay>1</weekDay><DayOfMonth>1</DayOfMonth><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>40</xloc><yloc>80</yloc></entry><entry><name>Preparar datamart (vaciar y miembros desconocidos)</name><description/><type>SQL</type><sql>-- G8 · Avance 4 · Primer paso del job: deja el datamart vacío y listo para recargar.
-- El Table output no puede usar &quot;truncate&quot; porque las dimensiones tienen FK desde los
-- hechos (lo advierte la prepa); por eso se vacía aquí, hechos primero y con CASCADE.
TRUNCATE fact_incidencias_equipaje, fact_equipaje_procesado, dim_tiempo, dim_region,
         dim_aeropuerto, dim_vuelo, dim_estado_inspeccion, dim_tipo_equipaje CASCADE;
-- Miembros &quot;desconocido&quot; (SK 0): maletas sin vuelo en el staging y sin inspección en MongoDB
INSERT INTO dim_vuelo VALUES (0, '------', '--', 'Sin vuelo asignado');
INSERT INTO dim_estado_inspeccion VALUES (0, 'SIN_INSPECCION', 'Sin inspección registrada en MongoDB', TRUE, FALSE);
</sql><useVariableSubstitution>F</useVariableSubstitution><sqlfromfile>F</sqlfromfile><sqlfilename/><sendOneStatement>F</sendOneStatement><connection>pg16_datamart_output</connection><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>200</xloc><yloc>80</yloc></entry><entry><name>t01 dim_tiempo</name><description/><type>TRANS</type><specification_method>filename</specification_method><trans_object_id/><filename>${Internal.Entry.Current.Directory}/t01_dim_tiempo.ktr</filename><transname/><arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files><set_logfile>N</set_logfile><logfile/><logext/><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><cluster>N</cluster><slave_server_name/><set_append_logfile>N</set_append_logfile><wait_until_finished>Y</wait_until_finished><follow_abort_remote>N</follow_abort_remote><create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>380</xloc><yloc>80</yloc></entry><entry><name>t02 dim_region</name><description/><type>TRANS</type><specification_method>filename</specification_method><trans_object_id/><filename>${Internal.Entry.Current.Directory}/t02_dim_region.ktr</filename><transname/><arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files><set_logfile>N</set_logfile><logfile/><logext/><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><cluster>N</cluster><slave_server_name/><set_append_logfile>N</set_append_logfile><wait_until_finished>Y</wait_until_finished><follow_abort_remote>N</follow_abort_remote><create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work><parameters><pass_all_parameters>Y</