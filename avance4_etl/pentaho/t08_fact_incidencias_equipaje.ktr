t;$sort&quot;: {&quot;tag_insp&quot;: 1}}</json_query><auth_database/><auth_user/><auth_password/><auth_mech/><auth_kerberos>N</auth_kerberos><connect_timeout/><socket_timeout/><use_ssl_socket_factory>N</use_ssl_socket_factory><read_preference>primary</read_preference><output_json>N</output_json><query_is_pipeline>Y</query_is_pipeline><execute_for_each_row>N</execute_for_each_row><use_connection_string>Y</use_connection_string><use_legacy_options>N</use_legacy_options><connection_string>${G8_MONGO_URI}</connection_string><mongo_fields><mongo_field><field_name>tag_insp</field_name><field_path>$.tag_insp</field_path><field_type>String</field_type><indexed_vals/></mongo_field><mongo_field><field_name>aeropuerto_incidencia</field_name><field_path>$.aeropuerto_incidencia</field_path><field_type>String</field_type><indexed_vals/></mongo_field><mongo_field><field_name>codigo_estado</field_name><field_path>$.codigo_estado</field_path><field_type>String</field_type><indexed_vals/></mongo_field><mongo_field><field_name>apertura_manual</field_name><field_path>$.apertura_manual</field_path><field_type>Boolean</field_type><indexed_vals/></mongo_field><mongo_field><field_name>tipo_incidencia</field_name><field_path>$.tipo_incidencia</field_path><field_type>String</field_type><indexed_vals/></mongo_field><mongo_field><field_name>tiempo_resolucion_min</field_name><field_path>$.tiempo_resolucion_min</field_path><field_type>Number</field_type><indexed_vals/></mongo_field><mongo_field><field_name>ts_inspeccion</field_name><field_path>$.ts_inspeccion</field_path><field_type>String</field_type><indexed_vals/></mongo_field></mongo_fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>40</xloc><yloc>60</yloc><draw>Y</draw></GUI></step><step><name>Ordenar inspecciones por etiqueta</name><type>SortRows</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><directory>%%java.io.tmpdir%%</directory><prefix>out</prefix><sort_size>1000000</sort_size><free_memory/><compress>N</compress><compress_variable/><unique_rows>N</unique_rows><fields><field><name>tag_insp</name><ascending>Y</ascending><case_sensitive>Y</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field></fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>220</xloc><yloc>60</yloc><draw>Y</draw></GUI></step><step><name>Input ruta y vuelo de la maleta (staging)</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>pg16_staging_input</connection><sql>-- Ruta y vuelo de cada maleta (staging), para completar las inspecciones de MongoDB
SELECT m.codigo_etiqueta                            AS tag_rfid_bag,
       SUBSTRING(r.itinerario_vuelos FROM 1 FOR 3)  AS ori,
       SUBSTRING(r.itinerario_vuelos FROM 5 FOR 3)  AS con,
       SUBSTRING(r.itinerario_vuelos FROM 13 FOR 3) AS des,
       vo.numero_vuelo
FROM movimiento_equipaje m
JOIN reserva_pnr r ON r.id_reserva_pnr = m.id_codigo_pnr
LEFT JOIN segmento_boleto s    ON s.boleto_id = m.id_boleto
LEFT JOIN pase_abordaje pa     ON pa.id_pase_abordaje = s.id_pase_abordaje
LEFT JOIN asignacion_puerta ap ON ap.id_asignacion = pa.id_asignacion_puerta
LEFT JOIN vuelo_operado vo     ON vo.id_vuelo_operado = ap.vuelo_asociado
WHERE m.tipo_evento = 'check_in'
ORDER BY m.codigo_etiqueta</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>40</xloc><yloc>200</yloc><draw>Y</draw></GUI></step><step><name>Ordenar maletas por etiqueta</name><type>SortRows</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><directory>%%java.io.tmpdir%%</directory><prefix>out</prefix><sort_size>1000000</sort_size><free_memory/><compress>N</compress><compress_variable/><unique_rows>N</unique_rows><fields><field><name>tag_rfid_bag</name><ascending>Y</ascending><case_sensitive>Y</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field></fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>220</xloc><yloc>200</yloc><draw>Y</draw></GUI></step><step><name>Input compensaciones (MongoDB)</name><type>MongoDbInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><hostname/><port/><use_all_replica_members>N</use_all_replica_members><db_name>aeropuerto_nosql</db_name><fields_name/><collection>notificaciones_pasajero</collection><json_field_name>json</json_field_name><json_query>{&quot;$match&quot;: {&quot;compensacion.monto_usd&quot;: {&quot;$exists&quot;: true}}}, {&quot;$project&quot;: {&quot;_id&quot;: 0, &quot;tag_notif&quot;: &quot;$codigo_etiqueta&quot;, &quot;monto_compensacion_usd&quot;: &quot;$compensacion.monto_usd&quot;}}, {&quot;$sort&quot;: {&quot;tag_notif&quot;: 1}}</json_query><auth_database/><auth_user/><auth_password/><auth_mech/><auth_kerberos>N</auth_kerberos><connect_timeout/><socket_timeout/><use_ssl_socket_factory>N</use_ssl_socket_factory><read_preference>primary</read_preference><output_json>N</output_json><query_is_pipeline>Y</query_is_pipeline><execute_for_each_row>N</execute_for_each_row><use_connection_string>Y</use_connection_string><use_legacy_options>N</use_legacy_options><connection_string>${G8_MONGO_URI}</connection_string><mongo_fields><mongo_field><field_name>tag_notif</field_name><field_path>$.tag_notif</field_path><field_type>String</field_type><indexed_vals/></mongo_field><mongo_field><field_name>monto_compensacion_usd</field_name><field_path>$.monto_compensacion_usd</field_path><field_type>Number</field_type><indexed_vals/></mongo_field></mongo_fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>40</xloc><yloc>340</yloc><draw>Y</draw></GUI></step><step><name>Ordenar compensaciones por etiqueta</name><type>SortRows</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><directory>%%java.io.tmpdir%%</directory><prefix>out</prefix><sort_size>1000000</sort_size><free_memory/><compress>N</compress><compress_variable/><unique_rows>N</unique_rows><fields><field><name>tag_notif</name><ascending>Y</ascending><case_sensitive>Y</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field></fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>220</xloc><yloc>340</yloc><draw>Y</draw></GUI></step><step><name>Unir inspección con la maleta</name><type>MergeJoin</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><join_type>INNER</join_type><step1>Ordenar inspecciones por etiqueta</step1><step2>Ordenar maletas por etiqueta</step2><keys_1><key>tag_insp</key></keys_1><keys_2><key>tag_rfid_bag</key></keys_2><attributes/><c